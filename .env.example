GITHUB_WEBHOOK_SECRET=whsec_your_webhook_secret
GITHUB_PRODUCTION_APP_ID=123456
# Dev GitHub App id — production processes the prod app's webhooks itself and
# downstreams this app's webhooks to connected developers (websocket tunnel)
GITHUB_DEVELOPMENT_APP_ID=234567
# The App's public slug (github.com/apps/<slug>) — "install the App" links point here
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_CLIENT_ID=Iv1.your_client_id
GITHUB_APP_CLIENT_SECRET=your_client_secret
TRAEFIK_HOST=coverage.mintplayer.com

# Also place the GitHub App's private key (App settings -> "Generate a private
# key") next to this file as ./github-app.pem — docker-compose bind-mounts it
# read-only into the container at /run/secrets/github-app.pem.
