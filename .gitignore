# .NET
bin/
obj/
*.user
.vs/
tmp/

# Node / Angular
node_modules/
dist/
# The GitHub Action ships its bundled dist (node20 action contract)
!action/dist/
.angular/
.nx/
out-tsc/
# Vitest coverage output. Both paths are spelled in full from the repo root: a
# bare `coverage/` would also match the Coverage/ project folder, because git is
# case-insensitive on Windows.
Coverage/ClientApp/coverage/
action/coverage/

# Environment
.env
*.pem

# Local smoke-test logs
boot-*.log

# Playwright MCP browser-session artifacts
.playwright-mcp/

# .NET test results (--results-directory artifacts/coverage). Deliberately NOT a
# root-level `coverage/`: git is case-insensitive on Windows, so that pattern also
# matches the Coverage/ project folder and hides the whole app from git.
/artifacts/
